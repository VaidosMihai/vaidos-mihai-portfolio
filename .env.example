# Canonical site URL used for metadataBase, OpenGraph, robots.txt, and sitemap.xml
# In Vercel, set this to your live production domain (e.g. https://vaidos-mihai-portfolio.vercel.app)
NEXT_PUBLIC_SITE_URL=https://vaidos-mihai-portfolio.vercel.app

# FormSubmit AJAX endpoint. Initially uses email; after activating via the confirmation
# link sent on the first live submission, you can swap to the random hashed URL provided by FormSubmit.
NEXT_PUBLIC_FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/vaidos.mihaiiulian@gmail.com
